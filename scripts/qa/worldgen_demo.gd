extends SceneTree
## Generates example WorldBlueprints for contrasting keyword combinations.
## Prints readable summaries; with --out=<dir> also writes one JSON file per example,
## index.json (read by worldgen_tests.gd as golden data) and SUMMARY.md.
## Usage: godot --headless --path . --script res://scripts/qa/worldgen_demo.gd -- --out=docs/worldgen/examples

const Gen := preload("res://scripts/worldgen/blueprint_generator.gd")

const SECTIONS := [
	{"title": "Same words, different seeds",
		"note": "Identity (biome, senses, tensions, headline themes) holds; texture changes.",
		"cases": [[["drowned", "hollow", "cathedral"], 1001], [["drowned", "hollow", "cathedral"], 1002], [["drowned", "hollow", "cathedral"], 1003]]},
	{"title": "Different words, same seed",
		"note": "Seed 1001 for every world; the words alone pull them apart.",
		"cases": [[["lightless", "sunken", "hollow"], 1001], [["barren", "tempest", "gilded"], 1001], [["forgotten", "hollow", "profane"], 1001]]},
	{"title": "Conflicting combinations",
		"note": "Opposed pushes on an axis become a tension resolved as regional patchwork, plus conflict rules.",
		"cases": [[["smoldering", "frozen", "ossuary"], 1001], [["hallowed", "profane", "cathedral"], 1001], [["towering", "sunken", "thorned"], 1001]]},
	{"title": "Synergistic combinations",
		"note": "Pairs of tags from different words add content neither word has alone.",
		"cases": [[["frozen", "drowned", "hollow"], 1001], [["gilded", "forgotten", "ossuary"], 1001], [["tempest", "frozen", "towering"], 1001]]},
	{"title": "Word order",
		"note": "Same words reordered: same interactions, different emphasis (later words weigh more).",
		"cases": [[["profane", "gilded", "hallowed"], 1001], [["hallowed", "gilded", "profane"], 1001]]},
]
const INVALID_CASES := [
	["frozen", "glimmering", "hollow"],
	["frozen", "frozen", "hollow"],
	["frozen", "hollow"],
	["frozen", 7, "hollow"],
	[" Frozen", "DROWNED", "hollow"],
]

func _initialize() -> void:
	var out_dir := ""
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--out="):
			out_dir = arg.get_slice("=", 1)
	var gen = Gen.new()
	var index := []
	var md := ["# Example WorldBlueprints", "",
		"Generated by `scripts/qa/worldgen_demo.gd`. **Prototype output**: vocabulary, weights and",
		"formulas are provisional. JSON files in this folder are golden fixtures for `worldgen_tests.gd`.", ""]
	var repeat_a := Gen.canonical_json(gen.generate(["drowned", "hollow", "cathedral"], 1001).blueprint)
	var repeat_b := Gen.canonical_json(Gen.new().generate(["drowned", "hollow", "cathedral"], 1001).blueprint)
	var repeat_line := "Same words, same seed: two independent generators produced byte-identical JSON: %s" % str(repeat_a == repeat_b)
	print(repeat_line)
	md.append_array(["## Same words, same seed", "", repeat_line + ".", ""])
	for section in SECTIONS:
		print("\n== %s ==" % section.title)
		md.append_array(["## " + section.title, "", section.note, "", "```text"])
		for case in section.cases:
			var blueprint: Dictionary = gen.generate(case[0], case[1]).blueprint
			var summary := Gen.summarize(blueprint)
			print(summary)
			md.append(summary)
			var file := "%s_%d.json" % ["_".join(case[0]), case[1]]
			if index.all(func(e): return e.file != file):
				index.append({"file": file, "keywords": case[0], "world_seed": str(case[1])})
				if not out_dir.is_empty():
					_write(out_dir.path_join(file), JSON.stringify(blueprint, "\t", true) + "\n")
		md.append_array(["```", ""])
	print("\n== Invalid inputs ==")
	md.append_array(["## Invalid inputs", "", "No partial world is produced when any error is present.", "", "```text"])
	for words in INVALID_CASES:
		var result: Dictionary = gen.generate(words, 1001)
		var line := "%s -> ok=%s errors=%s warnings=%s" % [JSON.stringify(words), result.ok,
			JSON.stringify(result.errors.map(func(e): return e.code)), JSON.stringify(result.warnings.map(func(w): return w.code))]
		print(line)
		md.append(line)
	md.append_array(["```", ""])
	if not out_dir.is_empty():
		_write(out_dir.path_join("index.json"), JSON.stringify(index, "\t", false) + "\n")
		_write(out_dir.path_join("SUMMARY.md"), "\n".join(md))
		print("\nWrote %d examples to %s" % [index.size(), out_dir])
	quit()

func _write(path: String, text: String) -> void:
	DirAccess.make_dir_recursive_absolute(path.get_base_dir())
	var file := FileAccess.open(path, FileAccess.WRITE)
	file.store_string(text)
