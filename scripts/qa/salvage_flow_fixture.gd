extends RefCounted
## The isolated Gate 2 salvage demonstration as one deterministic function.
## Used by salvage_demo.gd (writes the committed example) and by build_tests.gd.
## No scene, combat state, AI or courtyard code is touched; victory is a fixture.

const Catalog := preload("res://scripts/builds/build_catalog.gd")
const Rules := preload("res://scripts/builds/build_rules.gd")
const Salvage := preload("res://scripts/builds/salvage.gd")

const ENCOUNTER_ID := "fixture.marrow_duel"
const SIGNATURE := "ability.marrow_lunge"

static func player_build(rules) -> Dictionary:
	var build: Dictionary = rules.carry(rules.new_build("player.fixture", "profile.duelist"), "item.notched_sword").build
	return rules.equip(build, "item.notched_sword", "hand_r").build

static func corrupted_soul_build(rules) -> Dictionary:
	var build: Dictionary = rules.new_build("soul.marrow_swordsman", "profile.corrupted_swordsman")
	build = rules.carry(build, "item.notched_sword").build
	build = rules.carry(build, "item.marrow_arm").build
	build = rules.equip(build, "item.notched_sword", "hand_r").build
	return rules.equip(build, "item.marrow_arm", "arm_l").build

## Returns {"ok", "errors", "flow"}. `flow` records every step's inputs and outputs.
static func run(catalog) -> Dictionary:
	var rules = Rules.new(catalog)
	var salvage = Salvage.new(catalog, rules)
	var errors := []
	var player := player_build(rules)
	var soul := corrupted_soul_build(rules)
	var player_before: Dictionary = rules.resolve(player).resolved
	var soul_resolved: Dictionary = rules.resolve(soul).resolved
	var result := Salvage.victory_fixture(ENCOUNTER_ID, player, soul)
	var reward: Dictionary = salvage.rewards(result)
	errors.append_array(reward.errors)
	var ref: Dictionary = reward.refs[0] if reward.refs.size() == 1 else {}
	if ref.is_empty():
		errors.append({"code": "expected_exactly_one_ref", "count": reward.refs.size()})
		return {"ok": false, "errors": errors, "flow": {}}
	var acquired: Dictionary = salvage.acquire(player, ref)
	errors.append_array(acquired.errors)
	var equipped: Dictionary = rules.equip(acquired.build, ref.item, "arm_l")
	errors.append_array(equipped.errors)
	var player_after: Dictionary = rules.resolve(equipped.build).resolved
	var flow := {
		"catalog": {"version": catalog.version, "fingerprint": catalog.fingerprint},
		"step_1_player_build": {"build": player, "resolved": player_before},
		"step_2_corrupted_soul_build": {"build": soul, "resolved": soul_resolved},
		"step_3_victory_fixture": result,
		"step_4_salvage_refs": reward.refs,
		"step_5_acquired_and_equipped": {"after_acquire": acquired.build, "after_equip": equipped.build},
		"step_6_resolved_player": player_after,
		"step_7_change": rules.diff(player_before, player_after),
		"identity": {
			"ability": SIGNATURE,
			"catalog_fingerprint": catalog.ability_fingerprint(SIGNATURE),
			"enemy_fingerprint": _ability(soul_resolved, SIGNATURE).get("fingerprint", ""),
			"ref_fingerprint": ref.abilities[0].fingerprint,
			"player_fingerprint": _ability(player_after, SIGNATURE).get("fingerprint", ""),
			"enemy_effective": _ability(soul_resolved, SIGNATURE).get("effective", {}),
			"player_effective": _ability(player_after, SIGNATURE).get("effective", {}),
		},
	}
	return {"ok": errors.is_empty(), "errors": errors, "flow": flow}

static func _ability(resolved: Dictionary, id: String) -> Dictionary:
	for ability in resolved.get("abilities", []):
		if ability.id == id:
			return ability
	return {}

## Short human-readable account of the flow, regenerated with the JSON.
static func summary(flow: Dictionary) -> String:
	var lines := [
		"# Salvage flow example (generated)",
		"",
		"Generated by `scripts/qa/salvage_demo.gd` from catalog %s (`%s`). Do not edit by hand;" % [flow.catalog.version, flow.catalog.fingerprint],
		"`bash scripts/tooling/test_builds.sh` regenerates this file and fails if it differs.",
		"All values are provisional placeholders.",
		"",
		"| Step | Result |",
		"| --- | --- |",
		"| 1. Player build | `%s`: %s |" % [flow.step_1_player_build.build.build_id, _ability_list(flow.step_1_player_build.resolved)],
		"| 2. Corrupted soul build | `%s`: %s |" % [flow.step_2_corrupted_soul_build.build.build_id, _ability_list(flow.step_2_corrupted_soul_build.resolved)],
		"| 3. Victory (fixture) | `%s`, victor `%s` |" % [flow.step_3_victory_fixture.encounter_id, flow.step_3_victory_fixture.victor_build_id],
		"| 4. Salvage reference | `%s` → item `%s` (ref `%s`) |" % [flow.step_4_salvage_refs[0].source.slot, flow.step_4_salvage_refs[0].item, flow.step_4_salvage_refs[0].ref_id],
		"| 5. Acquire, equip | carried %s → equipped %s |" % [JSON.stringify(flow.step_5_acquired_and_equipped.after_acquire.carried), JSON.stringify(flow.step_5_acquired_and_equipped.after_equip.equipped, "", true)],
		"| 6. Recalculated build | %s |" % _ability_list(flow.step_6_resolved_player),
		"| 7. Change | +%s; %s |" % [", ".join(flow.step_7_change.abilities_added), _stat_changes(flow.step_7_change.stats)],
		"",
		"## Same definition, different wielder",
		"",
		"`%s` fingerprint — catalog `%s`, enemy `%s`, salvage ref `%s`, player `%s`." % [flow.identity.ability,
			flow.identity.catalog_fingerprint, flow.identity.enemy_fingerprint, flow.identity.ref_fingerprint, flow.identity.player_fingerprint],
		"",
		"| Effective value | Corrupted soul | Player |",
		"| --- | --- | --- |",
	]
	for key in ["windup", "active", "recovery", "health_damage", "guard_posture", "reach"]:
		lines.append("| %s | %s | %s |" % [key, str(flow.identity.enemy_effective[key]), str(flow.identity.player_effective[key])])
	lines.append_array(["", "## Tradeoff introduced by the body modification", ""])
	for tradeoff in flow.step_7_change.new_tradeoffs:
		for side in ["advantages", "disadvantages"]:
			for entry in tradeoff[side]:
				lines.append("- **%s** (%s): %s" % [side.trim_suffix("s"), tradeoff.item, JSON.stringify(entry, "", true)])
	return "\n".join(lines) + "\n"

static func _ability_list(resolved: Dictionary) -> String:
	return ", ".join(resolved.abilities.map(func(a): return "%s `%s`" % [a.binding, a.id]))

static func _stat_changes(changes: Dictionary) -> String:
	var parts := []
	for stat_id in changes:
		parts.append("%s %s → %s" % [stat_id, str(changes[stat_id].before), str(changes[stat_id].after)])
	return ", ".join(parts)
